{
  "name": "tidy-traces",
  "description": "Distraction-free AI observability editions, using The Daily Diff newspaper reader.",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node ./scripts/generate-latest.js && astro build",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro",
    "test": "node --test tests/*.test.js",
    "check": "astro check",
    "fetch:sources": "node scripts/fetch-sources.js",
    "newspaper:daily": "node scripts/run-daily-newspaper.js",
    "newspaper:cron": "node scripts/install-newspaper-cron.js"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.7",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
