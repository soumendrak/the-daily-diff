---
import { getCollection } from 'astro:content';
import ObservabilityEdition from '../../../components/ObservabilityEdition.astro';
export async function getStaticPaths() {
  const editions = (await getCollection('observability')).sort((a, b) => a.data.date.localeCompare(b.data.date));
  return editions.map((edition, index) => ({
    params: { day: edition.data.date },
    props: {
      edition: edition.data,
      issue: index + 1,
      totalIssues: editions.length,
      prevDay: editions[index - 1]?.data.date ?? null,
      nextDay: editions[index + 1]?.data.date ?? null,
    },
  }));
}
---
<ObservabilityEdition {...Astro.props} />
