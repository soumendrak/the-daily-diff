---
import Layout from '../../layouts/Layout.astro';
import ThemeToggleButton from '../../components/ThemeToggleButton.astro';
import Footer from '../../components/Footer.astro';

const editionFiles = import.meta.glob('../../data/ai-observability/*.json', { eager: true, import: 'default' });
const editions = Object.values(editionFiles).sort((a, b) => b.date.localeCompare(a.date));
const latest = editions[0];
const platformGroups = latest.platform_groups;
const companyGroups = latest.company_groups;
const categories = [
  { key: 'observability', label: 'Traditional observability', number: '01' },
  { key: 'evals', label: 'Evals', number: '02' },
  { key: 'agents', label: 'AI-agent observability', number: '03' },
];
const pageUrl = new URL('/ai-observability/', Astro.site).toString();
const windowLabel = new Date(`${latest.story_window}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const pageSchema = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: 'AI Observability Daily',
  description: 'A daily editorial scan of traditional observability, AI evaluations, and AI-agent observability.',
  dateModified: latest.date,
  hasPart: latest.stories.map((story, index) => ({
    '@type': 'Article',
    position: index + 1,
    headline: story.title,
    url: story.url,
    datePublished: story.published,
  })),
};
---

<Layout
  title="AI Observability Daily — The Daily Diff"
  description="A daily editorial scan of traditional observability, AI evaluations, and AI-agent observability."
  jsonLd={pageSchema}
>
  <main class="page-container ai-observability-page">
    <header class="ai-observability-masthead">
      <div class="ai-observability-topline">
        <a href="/" class="ai-observability-home">The Daily Diff</a>
        <ThemeToggleButton />
      </div>
      <p class="ai-observability-kicker">A focused daily edition · Issue {editions.length}</p>
      <h1>AI Observability<br /><em>Daily</em></h1>
      <p class="ai-observability-dek">{latest.dek}</p>
      <div class="ai-observability-meta">
        <time datetime={latest.date}>{new Date(`${latest.date}T00:00:00`).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span>Coverage window: {windowLabel}</span>
        <span>{latest.stories.length === 0 ? 'No qualifying stories' : `${latest.stories.length} selected stories`}</span>
      </div>
      <hr class="ai-observability-rule" />
      <p class="ai-observability-editor-note">Strict date gate: only items published on {windowLabel} are eligible. We checked official engineering blogs and product-update surfaces; if no same-day item appears, it stays out.</p>
    </header>

    <section class="ai-observability-audit" aria-labelledby="platforms-heading">
      <h2 id="platforms-heading"><span>1</span> Platforms and source blocks visited</h2>
      <p>Fetch order: official engineering blog or newsroom first; product changelog/release notes next; then confirm the individual item’s own publication date.</p>
      <div class="ai-observability-audit-grid">
        {platformGroups.map((group) => (
          <section class="ai-observability-audit-group">
            <h3>{group.label}</h3>
            <p>{group.description}</p>
            <ul>
              {group.platforms.map((platform) => (
                <li>
                  <a href={platform.url} target="_blank" rel="noopener noreferrer">{platform.name} ↗</a>
                  {platform.note && <small class="ai-observability-source-note">{platform.note}</small>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="ai-observability-audit" aria-labelledby="companies-heading">
      <h2 id="companies-heading"><span>2</span> Companies and projects in this beat</h2>
      <div class="ai-observability-company-grid">
        {companyGroups.map((group) => (
          <div class="ai-observability-company-group">
            <h3>{group.label}</h3>
            <p>{group.companies.join(' · ')}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="ai-observability-sweep" aria-labelledby="sweep-heading">
      <h2 id="sweep-heading"><span>3</span> What the sweep found</h2>
      <p><strong>{latest.source_sweep.date_matched_items} dated source entries</strong> surfaced across {latest.source_sweep.eligible_publishers.length} publishers, curated into {latest.source_sweep.curated_story_count} stories. The set includes company blog posts, product release notes, and one SRE practice announcement—not just vendor blog articles.</p>
      <p><strong>No October 12 item surfaced</strong> on these checked indexes: {latest.source_sweep.no_october_12_item_surfaced.join(', ')}.</p>
      <p class="ai-observability-scope-note">{latest.source_sweep.out_of_window} “No item surfaced” describes only the official pages checked, not every employee post or community discussion.</p>
    </section>

    <h2 class="ai-observability-stories-heading"><span>4</span> Stories published on October 12</h2>

    {latest.stories.length === 0 ? (
      <div class="ai-observability-empty" role="status">
        <h2>No qualifying stories</h2>
        <p>Nothing published on {windowLabel} met this edition’s scope. We’re leaving today’s issue empty instead of filling it with older links.</p>
      </div>
    ) : (
      <div class="ai-observability-sections">
        {categories.map((category) => {
          const stories = latest.stories.filter((story) => story.category_key === category.key);
          return (
            <section class="ai-observability-section" aria-labelledby={`section-${category.key}`}>
              <div class="ai-observability-section-heading">
                <span class="ai-observability-section-number">{category.number}</span>
                <h2 id={`section-${category.key}`}>{category.label}</h2>
                <span class="ai-observability-section-count">{stories.length} stories</span>
              </div>
              <div class="ai-observability-story-grid">
                {stories.map((story) => (
                  <article class="ai-observability-story">
                    <div class="ai-observability-story-meta">
                      <span>{story.publisher}</span>
                      <time datetime={story.published}>{story.published === '2026-09' ? 'September 2026' : new Date(`${story.published}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                    </div>
                    <h3>
                      <a href={story.url} target="_blank" rel="noopener noreferrer">
                        {story.title}<span aria-hidden="true"> ↗</span><sup class="ai-observability-citation">[{latest.stories.findIndex((item) => item.url === story.url) + 1}]</sup>
                      </a>
                    </h3>
                    <p>{story.summary}</p>
                    <p class="ai-observability-takeaway"><strong>Why it matters</strong> {story.takeaway}</p>
                  </article>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    )}

    <section class="ai-observability-sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      <ol>
        {latest.stories.map((story) => (
          <li><a href={story.url} target="_blank" rel="noopener noreferrer">{story.publisher}: {story.title}</a></li>
        ))}
      </ol>
    </section>

    {editions.length > 1 && (
      <nav class="ai-observability-archive" aria-label="Past AI Observability editions">
        <h2>Previous editions</h2>
        <ul>
          {editions.slice(1).map((edition) => (
            <li><a href={`/ai-observability/${edition.date}/`}>{edition.date}</a> · {edition.stories.length} stories</li>
          ))}
        </ul>
      </nav>
    )}

    <p class="ai-observability-method">Editorial selection and summaries are independent of the linked publishers. Product capabilities and claims are attributed to their original sources.</p>
    <Footer showDelayNote={false} />
  </main>
</Layout>

<style lang="scss">
.ai-observability-page {
  max-width: 1080px;
  padding-top: clamp(1.5rem, 5vw, 4rem);
}
.ai-observability-masthead { max-width: 760px; margin: 0 auto 3rem; }
.ai-observability-topline { display: flex; justify-content: space-between; align-items: center; }
.ai-observability-home, .ai-observability-kicker, .ai-observability-meta, .ai-observability-section-number, .ai-observability-section-count, .ai-observability-story-meta, .ai-observability-method {
  font-size: .72rem; letter-spacing: .07em; text-transform: uppercase;
}
.ai-observability-home { color: var(--accent-ink); font-weight: 700; }
.ai-observability-kicker { color: var(--ink-faint); margin: 2.5rem 0 .5rem; }
.ai-observability-masthead h1 { font-family: var(--font-display); font-size: clamp(3rem, 8vw, 5.7rem); line-height: .98; letter-spacing: -.055em; margin: 0; }
.ai-observability-masthead h1 em { color: var(--accent); font-weight: 500; }
.ai-observability-dek { font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.4rem); color: var(--ink-soft); margin: 1.25rem 0; }
.ai-observability-meta { display: flex; gap: 1rem; color: var(--ink-faint); }
.ai-observability-rule { border: 0; border-top: 3px double var(--rule); margin: 1.25rem 0; }
.ai-observability-editor-note { font-size: .9rem; max-width: 680px; color: var(--ink-soft); }
.ai-observability-audit, .ai-observability-sweep { margin: 2rem 0; }
.ai-observability-audit > h2, .ai-observability-sweep > h2, .ai-observability-stories-heading { display:flex; align-items:baseline; gap:.65rem; font:700 clamp(1.2rem, 3vw, 1.6rem)/1.2 var(--font-display); border-bottom:1px solid var(--rule-soft); padding-bottom:.55rem; }
.ai-observability-audit > h2 span, .ai-observability-sweep > h2 span, .ai-observability-stories-heading span { color:var(--accent-ink); font-size:.72em; }
.ai-observability-audit > p, .ai-observability-sweep > p { color:var(--ink-soft); font-size:.88rem; }
.ai-observability-audit-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
.ai-observability-audit-group, .ai-observability-company-group { background:var(--bg-sheet); border:1px solid var(--rule-hair); padding:1rem; }
.ai-observability-audit-group h3, .ai-observability-company-group h3 { font:700 1rem/1.3 var(--font-display); margin:0 0 .5rem; }
.ai-observability-audit-group p { color:var(--ink-faint); font-size:.78rem; margin:.25rem 0 .7rem; }
.ai-observability-audit-group ul { columns:2; gap:1.5rem; padding-left:1rem; margin:.5rem 0 0; }
.ai-observability-audit-group li { break-inside:avoid; font-size:.76rem; line-height:1.5; margin:.2rem 0; }
.ai-observability-source-note { display:block; color:var(--ink-faint); font-size:.68rem; line-height:1.35; }
.ai-observability-audit-group a, .ai-observability-archive a, .ai-observability-sources a { color:var(--accent-ink); }
.ai-observability-company-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; }
.ai-observability-company-group p { margin:0; color:var(--ink-soft); font-size:.84rem; line-height:1.6; }
.ai-observability-sweep { background:var(--accent-soft); border-left:3px solid var(--accent); padding:1rem 1.25rem; }
.ai-observability-sweep > h2 { margin-top:0; }
.ai-observability-scope-note { font-size:.78rem !important; font-style:italic; }
.ai-observability-stories-heading { margin-top:3rem; }
.ai-observability-empty { max-width: 700px; margin: 3rem auto; padding: 2rem; text-align: center; background: var(--bg-sheet); border: 1px solid var(--rule-soft); }
.ai-observability-empty h2 { font: 700 1.5rem var(--font-display); margin: 0 0 .5rem; }
.ai-observability-empty p { color: var(--ink-soft); margin: 0; }
.ai-observability-section { margin: 3rem 0; }
.ai-observability-section-heading { display: flex; align-items: baseline; gap: .8rem; border-bottom: 2px solid var(--rule); padding-bottom: .55rem; margin-bottom: 1.2rem; }
.ai-observability-section-number, .ai-observability-section-count { color: var(--ink-faint); }
.ai-observability-section-heading h2 { font: 700 clamp(1.3rem, 3vw, 1.8rem)/1.2 var(--font-display); margin: 0; flex: 1; }
.ai-observability-story-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--rule-hair); border: 1px solid var(--rule-hair); }
.ai-observability-story { background: var(--bg-sheet); padding: clamp(1rem, 2.4vw, 1.7rem); }
.ai-observability-story-meta { display: flex; justify-content: space-between; gap: .75rem; color: var(--ink-faint); font-size: .65rem; }
.ai-observability-story h3 { font: 700 1.2rem/1.3 var(--font-display); margin: .75rem 0; }
.ai-observability-story h3 a:hover { color: var(--accent-ink); }
.ai-observability-citation { color:var(--accent-ink); font:700 .68rem var(--font-body); vertical-align:super; margin-left:.18rem; }
.ai-observability-story h3 span { color: var(--accent-ink); font: .8em sans-serif; }
.ai-observability-story p { color: var(--ink-soft); font-size: .91rem; line-height: 1.65; }
.ai-observability-story .ai-observability-takeaway { border-top: 1px solid var(--rule-hair); padding-top: .7rem; font-size: .84rem; }
.ai-observability-takeaway strong { color: var(--ink); }
.ai-observability-sources { margin:2.5rem 0; padding:1rem 1.25rem; border-top:1px solid var(--rule-soft); background:var(--bg-sheet); }
.ai-observability-sources h2 { font:700 1.1rem var(--font-display); }
.ai-observability-sources ol { columns:2; gap:2rem; padding-left:1.5rem; }
.ai-observability-sources li { break-inside:avoid; margin:.3rem 0; font-size:.78rem; line-height:1.45; }
.ai-observability-archive { border-top: 1px solid var(--rule-soft); padding-top: 1rem; }
.ai-observability-archive h2 { font: 700 1.1rem var(--font-display); }
.ai-observability-archive ul { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding: 0; list-style: none; font-size: .85rem; }
.ai-observability-archive a { color: var(--accent-ink); }
.ai-observability-method { color: var(--ink-faint); font-size: .62rem; margin-top: 2.5rem; }
@media (max-width: 680px) {
  .ai-observability-story-grid, .ai-observability-audit-grid, .ai-observability-company-grid { grid-template-columns: 1fr; }
  .ai-observability-audit-group ul, .ai-observability-sources ol { columns: 1; }
  .ai-observability-section-heading { flex-wrap: wrap; }
  .ai-observability-section-count { margin-left: auto; }
  .ai-observability-meta { flex-wrap: wrap; }
}
</style>
