---
import { getCollection } from 'astro:content';
import ObservabilityEdition from '../components/ObservabilityEdition.astro';
const editions = (await getCollection('observability')).sort((a, b) => a.data.date.localeCompare(b.data.date));
const latest = editions.at(-1);
if (!latest) throw new Error('Add a curated AI observability edition before building.');
---
<ObservabilityEdition edition={latest.data} issue={editions.length} totalIssues={editions.length} prevDay={editions.at(-2)?.data.date ?? null} nextDay={null} isHomepage />
